  "title": "Clarifying & Understanding",
  "topic": "communication",
  "situation": "Asking people to repeat or explain",
  "description": "Essential phrases for communication breakdowns and learning Portuguese in real conversations.",
  "phrases": [
    {
      "id": "cu-1",
      "pt": "Desculpa, não entendi.",
