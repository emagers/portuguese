    },
    {
      "id": "pp-4",
      "pt": "Vou chegar um pouco atrasado.",
      "en": "I’m going to arrive a little late.",
      "ipa": "vow ʃeˈɡaʁ ũ ˈpo.ku a.tɾaˈza.du"
    },
    {
      "id": "pp-5",
      "pt": "Me manda o endereço.",
      "en": "Send me the address.",
      "ipa": "mi ˈmɐ̃.dɐ u ẽ.deˈɾe.su"
    },
    {
      "id": "pp-6",
      "pt": "Posso levar um amigo?",
      "en": "Can I bring a friend?",
      "ipa": "ˈpɔ.su leˈvaʁ ũ aˈmi.ɡu"
    },
    {
      "id": "pp-7",
