      "options": [
        "Eu tenho uma irmã.",
        "Eu tenho um irmão.",
        "Ela tem uma irmã.",
        "Eu sou uma irmã."
      ],
      "answer": "Eu tenho uma irmã.",
      "explanation": "The sentence says 'I have a sister'."
    }
  ]
