      "explanation": "'Sete' means 7."
    },
    {
      "id": "q2",
      "type": "fill_blank",
      "prompt": "Complete: Eles ___ brasileiros. (ser)",
      "options": [
        "sou",
        "é",
        "somos",
        "são"
      ],
      "answer": "são",
      "explanation": "'Eles' takes 'são': 'Eles são brasileiros'."
    },
    {
      "id": "q3",
      "type": "translate_pt_en",
      "prompt": "Ela trabalha no banco.",
      "options": [
        "She works at the bank.",
        "He works at the bank.",
        "She studies at school.",
        "They work at the bank."
      ],
      "answer": "She works at the bank.",
      "explanation": "'Ela trabalha' means 'she works'."
    },
    {
      "id": "q4",
      "type": "multiple_choice",
      "prompt": "Choose the feminine plural article for 'amigas'.",
      "options": [
        "o",
        "a",
        "os",
        "as"
      ],
      "answer": "as",
      "explanation": "'Amigas' is feminine plural, so it uses 'as'."
    },
    {
      "id": "q5",
      "type": "translate_en_pt",
      "prompt": "Translate: 'Good night.'",
      "options": [
        "Boa noite.",
        "Bom dia.",
        "Boa tarde.",
        "Até logo."
      ],
      "answer": "Boa noite.",
      "explanation": "'Boa noite' means both 'good evening' and 'good night'."
