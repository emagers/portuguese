        "crescimento suportável",
        "progresso sustentado"
      ],
      "answer": "desenvolvimento sustentável",
      "explanation": "'Desenvolvimento sustentável' is the standard term."
    },
    {
      "id": "q6",
      "type": "multiple_choice",
      "prompt": "Which phrase means 'on the other hand'?",
      "options": [
        "por outro lado",
        "além disso",
        "de acordo com",
        "em primeiro lugar"
      ],
      "answer": "por outro lado",
      "explanation": "'Por outro lado' introduces a contrasting point."
    }
