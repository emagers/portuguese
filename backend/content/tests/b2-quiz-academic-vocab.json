      "id": "q2",
      "type": "translate_pt_en",
      "prompt": "O governo anunciou novas medidas.",
      "options": [
        "The government announced new measures.",
        "The government denied new measures.",
        "The company announced new measures.",
        "The government postponed new meetings."
      ],
      "answer": "The government announced new measures.",
      "explanation": "'Governo' means 'government' and 'medidas' means 'measures'."
    },
    {
      "id": "q3",
      "type": "multiple_choice",
      "prompt": "Which word means 'evidence'?",
      "options": [
        "evidência",
        "prejuízo",
        "vantagem",
        "ameaça"
      ],
      "answer": "evidência",
      "explanation": "'Evidência' is the direct equivalent of 'evidence'."
    },
    {
      "id": "q4",
      "type": "multiple_choice",
      "prompt": "What is the best meaning of 'apesar de'?",
      "options": [
        "despite",
        "because of",
        "instead of",
        "according to"
      ],
      "answer": "despite",
      "explanation": "'Apesar de' introduces contrast, like 'despite'."
    },
    {
