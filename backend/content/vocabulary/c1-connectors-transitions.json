  "cards": [
    {
      "id": "conn-no-entanto",
      "pt": "no entanto",
      "en": "however",
      "pos": "phrase",
      "gender": null,
      "ipa": "nu ẽˈtɐ̃.tu",
      "example": {
        "pt": "O plano é caro; no entanto, é necessário.",
