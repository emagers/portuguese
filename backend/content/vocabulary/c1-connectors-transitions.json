      "gender": null,
      "ipa": "aw ˈpa.su ki",
      "example": {
        "pt": "Ele prefere teoria, ao passo que ela gosta de prática.",
        "en": "He prefers theory, whereas she likes practice."
      },
      "tags": [
        "connectors"
      ]
    },
    {
      "id": "conn-em-contrapartida",
