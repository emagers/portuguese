  "title": "Numbers at the Market",
  "titlePt": "Números na Feira",
  "summary": "A customer buys fruit at a street market and practices numbers and prices.",
  "lines": [
    {
      "speaker": "Feirante",
      "pt": "Bom dia! Vai querer banana hoje?",
      "en": "Good morning! Would you like bananas today?"
    },
    {
      "speaker": "Clara",
      "pt": "Bom dia! Quanto custa a dúzia?",
      "en": "Good morning! How much does a dozen cost?"
    },
    {
      "speaker": "Feirante",
      "pt": "A dúzia custa oito reais.",
      "en": "A dozen costs eight reais."
    },
    {
      "speaker": "Clara",
      "pt": "Eu quero seis bananas, por favor.",
      "en": "I want six bananas, please."
    },
    {
      "speaker": "Feirante",
      "pt": "Seis bananas são quatro reais.",
      "en": "Six bananas are four reais."
    },
    {
      "speaker": "Clara",
      "pt": "Também quero três maçãs.",
      "en": "I also want three apples."
    },
    {
      "speaker": "Feirante",
      "pt": "Tudo fica nove reais.",
      "en": "Everything comes to nine reais."
    },
    {
      "speaker": "Clara",
      "pt": "Aqui está o dinheiro. Obrigada!",
      "en": "Here is the money. Thank you!"
    },
    {
      "speaker": "Feirante",
      "pt": "De nada. Boa feira!",
      "en": "You're welcome. Enjoy the market!"
    }
  ],
