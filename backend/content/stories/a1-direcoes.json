  "title": "Asking for Directions",
  "titlePt": "Pedindo Direções",
  "summary": "A visitor asks how to get to the bus stop using simple direction words.",
  "lines": [
    {
      "speaker": "Rita",
      "pt": "Com licença. Onde fica o ponto de ônibus?",
      "en": "Excuse me. Where is the bus stop?"
    },
    {
      "speaker": "Homem",
      "pt": "Fica perto da praça.",
      "en": "It is near the square."
    },
    {
      "speaker": "Rita",
      "pt": "É longe daqui?",
      "en": "Is it far from here?"
    },
    {
      "speaker": "Homem",
      "pt": "Não, é perto. Siga em frente.",
      "en": "No, it is close. Go straight ahead."
    },
    {
      "speaker": "Rita",
      "pt": "Depois?",
      "en": "After that?"
    },
    {
      "speaker": "Homem",
      "pt": "Vire à direita na padaria.",
      "en": "Turn right at the bakery."
    },
    {
      "speaker": "Rita",
      "pt": "O ponto fica na praça?",
      "en": "Is the stop in the square?"
    },
    {
      "speaker": "Homem",
      "pt": "Sim, fica em frente ao banco.",
      "en": "Yes, it is across from the bank."
    },
    {
      "speaker": "Rita",
      "pt": "Muito obrigada!",
      "en": "Thank you very much!"
    }
  ],
